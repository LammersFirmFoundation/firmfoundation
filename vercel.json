{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/review",
      "destination": "https://g.page/r/CXKLzN9BrPMsEBM/review",
      "permanent": false
    },
    {
      "source": "/services/tree-services",
      "destination": "/services/tree-removal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
